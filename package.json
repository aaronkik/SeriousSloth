{
  "name": "serioussloth",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "test:ci": "turbo run test:ci",
    "prepare": "husky"
  },
  "devDependencies": {
    "husky": "9.1.7",
    "oxfmt": "0.78.0"
  },
  "engines": {
    "node": "26.x"
  },
  "packageManager": "bun@1.4.4",
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
